{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HUMAN ERROR",
  "version": "0.2.0",
  "identifier": "com.humanerror.prototype",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/make-dist.mjs && node scripts/gen-icons.mjs",
    "beforeBuildCommand": "node scripts/make-dist.mjs && node scripts/gen-icons.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HUMAN ERROR",
        "url": "launcher.html",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
